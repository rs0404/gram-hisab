# Bump WEB_VERSION for screen/logic updates (installed silently on phones).
# Bump APK_CODE + APK_NAME only when the Android part (src/, AndroidManifest.xml) changes.
# MIN_NATIVE = oldest APK_CODE that can run the current screens (raise it when the screens need a new Android feature).
WEB_VERSION=1.12.0
APK_CODE=13
APK_NAME=1.12
MIN_NATIVE=9
APK_NOTES="New name Hisab ko Sathi, new logo, quick chicken sale on Home"
